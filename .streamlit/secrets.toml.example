# 請複製以下內容到雲端平台（如 Streamlit Community Cloud）的 Secrets 設定，
# 或在另一台電腦開發時複製為 .streamlit/secrets.toml（此真名檔案已被 .gitignore 排除，不會上傳至 GitHub）

GEMINI_API_KEY = "請填入你的_Gemini_API_Key"
GEMINI_MODEL = "gemini-3.6-flash"
FINMIND_TOKEN = ""       # 選填：FinMind 免費會員 Token（提高每小時查詢上限）
APP_PASSWORD = ""        # 選填：設定雲端登入密碼（留空代表不鎖密碼）
